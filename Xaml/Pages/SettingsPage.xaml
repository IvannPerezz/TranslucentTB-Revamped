<local:FramelessPage
    x:Class="TranslucentTB.Xaml.Pages.SettingsPage"
    x:Uid="SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TranslucentTB.Xaml.Pages"
    xmlns:controls="using:TranslucentTB.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windows11Present="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 14)"
    xmlns:windows11NotPresent="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractNotPresent(Windows.Foundation.UniversalApiContract, 14)"
    mc:Ignorable="d" Width="860" Height="580" ExpandIntoTitlebar="True" IsClosable="True">
    <!-- The host clips this window to a rounded rectangle of 26px (macOS 26 style). -->

    <local:FramelessPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SettingsSidebarBackground" Color="#2E000000" />
                    <SolidColorBrush x:Key="SettingsSegmentBackground" Color="#3D767680" />
                    <!-- Selections are glass: a light acrylic layer over whatever is behind, text keeps its color -->
                    <AcrylicBrush x:Key="SettingsSelectionBackground" BackgroundSource="Backdrop" TintColor="#FFFFFF" TintOpacity="0.10" FallbackColor="#33FFFFFF" />
                    <SolidColorBrush x:Key="SettingsSelectionStroke" Color="#26FFFFFF" />
                    <AcrylicBrush x:Key="SettingsSegmentIndicator" BackgroundSource="Backdrop" TintColor="#FFFFFF" TintOpacity="0.16" FallbackColor="#40FFFFFF" />
                    <!-- iMessage blue (dark appearance) -->
                    <SolidColorBrush x:Key="SettingsToggleOnBackground" Color="#0A84FF" />
                    <SolidColorBrush x:Key="SettingsToggleOffBackground" Color="#39393D" />
                    <!-- hairline around the window, light catching the edge as on macOS -->
                    <SolidColorBrush x:Key="SettingsWindowStroke" Color="#24FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SettingsSidebarBackground" Color="#0C000000" />
                    <SolidColorBrush x:Key="SettingsSegmentBackground" Color="#1F767680" />
                    <AcrylicBrush x:Key="SettingsSelectionBackground" BackgroundSource="Backdrop" TintColor="#FFFFFF" TintOpacity="0.55" FallbackColor="#B3FFFFFF" />
                    <SolidColorBrush x:Key="SettingsSelectionStroke" Color="#14000000" />
                    <AcrylicBrush x:Key="SettingsSegmentIndicator" BackgroundSource="Backdrop" TintColor="#FFFFFF" TintOpacity="0.7" FallbackColor="#E6FFFFFF" />
                    <!-- iMessage blue (light appearance) -->
                    <SolidColorBrush x:Key="SettingsToggleOnBackground" Color="#007AFF" />
                    <SolidColorBrush x:Key="SettingsToggleOffBackground" Color="#E9E9EB" />
                    <SolidColorBrush x:Key="SettingsWindowStroke" Color="#1F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SettingsSidebarBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SettingsSegmentBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SettingsSelectionBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SettingsSelectionStroke" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SettingsSegmentIndicator" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SettingsToggleOnBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SettingsToggleOffBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="SettingsWindowStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The page draws its own window controls, hide the stock close button -->
            <Style x:Key="CloseButtonStyle" TargetType="controls:ChromeButton">
                <Setter Property="Width" Value="0" />
                <Setter Property="Height" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:ChromeButton">
                            <Grid />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- macOS window controls ("traffic lights"), same metrics as AirPlay Receiver: 13px, 9px apart -->
            <Style x:Key="TrafficLightStyle" TargetType="Button">
                <Setter Property="Width" Value="13" />
                <Setter Property="Height" Value="13" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="PressedOverlay.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Ellipse Fill="{TemplateBinding Background}" />
                                <Ellipse Stroke="#29000000" StrokeThickness="1" />
                                <Ellipse x:Name="PressedOverlay" Fill="#38000000" Opacity="0" />
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TrafficLightGlyphStyle" TargetType="Path">
                <Setter Property="Width" Value="13" />
                <Setter Property="Height" Value="13" />
                <Setter Property="Stroke" Value="#9E000000" />
                <Setter Property="Fill" Value="#9E000000" />
                <Setter Property="StrokeThickness" Value="1.3" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <!-- Figtree (SIL OFL 1.1), with system fallbacks if the file cannot be loaded -->
            <FontFamily x:Key="SettingsFontFamily">ms-appx:///Fonts/Figtree.ttf#Figtree, Segoe UI Variable Text, Segoe UI</FontFamily>

            <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <Grid.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.12" />
                                </Grid.BackgroundTransition>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsPillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SettingsAccentPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SettingsGroupStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="4,22,0,8" />
            </Style>

            <Style x:Key="SettingsRowStyle" TargetType="Grid">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinHeight" Value="58" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>

            <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <Style x:Key="SettingsRowDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <Style x:Key="SettingsDividerStyle" TargetType="Rectangle">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- macOS / iOS style switch: filled pill track, white knob with a soft shadow, slight overshoot -->
            <!-- A ToggleButton: it flips on a plain click, which a re-templated ToggleSwitch does not -->
            <Style x:Key="SettingsToggleStyle" TargetType="ToggleButton">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="SwitchRoot" Width="44" Height="26" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.3">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="KnobFace.Fill" Value="#FFF2F2F2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="SwitchRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="18" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="18" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="KnobFace.Fill" Value="#FFF2F2F2" />
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="18" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="SwitchRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="18" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="OffTrack" CornerRadius="13" Background="{ThemeResource SettingsToggleOffBackground}" />
                                <Border x:Name="OnTrack" CornerRadius="13" Background="{ThemeResource SettingsToggleOnBackground}" Opacity="0" />
                                <Grid x:Name="Knob" Width="22" Height="22" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="KnobTranslate" />
                                    </Grid.RenderTransform>
                                    <Ellipse Fill="#30000000" Margin="-0.5,0.5,-0.5,-1.5" />
                                    <Ellipse x:Name="KnobFace" Fill="White" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsNavIconStyle" TargetType="Border">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>
        </ResourceDictionary>
    </local:FramelessPage.Resources>

    <!-- Putting all within UserControl makes VSM happy -->
    <UserControl FontFamily="{StaticResource SettingsFontFamily}">
        <Grid Loaded="RootLoaded">
            <!-- hairline edge over the window region, softening its corners as on macOS -->
            <Grid
                x:Name="WindowCard"
                CornerRadius="26"
                BorderBrush="{ThemeResource SettingsWindowStroke}"
                BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: a heavier layer than the content, so it reads as structure -->
            <Grid x:Name="Sidebar" Background="{ThemeResource SettingsSidebarBackground}" CornerRadius="25,0,0,25" Padding="10,0,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Text="TranslucentTB"
                    FontSize="15"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <Grid x:Name="NavHost">
                        <Border
                            x:Name="SelectionPill"
                            Height="40"
                            VerticalAlignment="Top"
                            CornerRadius="10"
                            Background="{ThemeResource SettingsSelectionBackground}"
                            BorderBrush="{ThemeResource SettingsSelectionStroke}"
                            BorderThickness="1" />

                        <StackPanel x:Name="NavList" Spacing="2">
                            <Button x:Name="NavDesktop" Style="{StaticResource SettingsNavButtonStyle}" Click="NavClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource SettingsNavIconStyle}" Background="#0A84FF">
                                        <PathIcon Data="{StaticResource DesktopIcon}" Width="14" Height="14" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Uid="TrayFlyoutPage_Desktop" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavVisibleWindow" Style="{StaticResource SettingsNavButtonStyle}" Click="NavClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource SettingsNavIconStyle}" Background="#5E5CE6">
                                        <FontIcon Glyph="&#xE737;" FontSize="14" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Uid="TrayFlyoutPage_VisibleWindow" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavMaximisedWindow" Style="{StaticResource SettingsNavButtonStyle}" Click="NavClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource SettingsNavIconStyle}" Background="#BF5AF2">
                                        <FontIcon Glyph="&#xE740;" FontSize="14" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Uid="TrayFlyoutPage_MaximizedWindow" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavStartOpened" Style="{StaticResource SettingsNavButtonStyle}" Click="NavClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource SettingsNavIconStyle}" Background="#FF9F0A">
                                        <Grid>
                                            <windows11Present:FontIcon Glyph="&#xE8FC;" FontSize="14" Foreground="White" />
                                            <windows11NotPresent:FontIcon FontFamily="HoloLens MDL2 Assets" Glyph="&#xE782;" FontSize="14" Foreground="White" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Uid="TrayFlyoutPage_StartOpened" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavSearchOpened" Style="{StaticResource SettingsNavButtonStyle}" Click="NavClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource SettingsNavIconStyle}" Background="#30B0C7">
                                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Uid="TrayFlyoutPage_SearchOpened" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavTaskViewOpened" Style="{StaticResource SettingsNavButtonStyle}" Click="NavClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource SettingsNavIconStyle}" Background="#FF375F">
                                        <FontIcon Glyph="&#xE7C4;" FontSize="14" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Uid="TrayFlyoutPage_TaskViewOpened" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavBatterySaver" Style="{StaticResource SettingsNavButtonStyle}" Click="NavClicked" Visibility="{x:Bind SystemHasBattery, Mode = OneTime}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource SettingsNavIconStyle}" Background="#34C759">
                                        <FontIcon Glyph="&#xE8BE;" FontSize="14" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Uid="TrayFlyoutPage_BatterySaver" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Rectangle Height="1" Margin="8,6" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Button x:Name="NavGeneral" Style="{StaticResource SettingsNavButtonStyle}" Click="NavClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource SettingsNavIconStyle}" Background="#8E8E93">
                                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Uid="SettingsPage_General" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavAdvanced" Style="{StaticResource SettingsNavButtonStyle}" Click="NavClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource SettingsNavIconStyle}" Background="#636366">
                                        <FontIcon Glyph="&#xE90F;" FontSize="14" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Uid="SettingsPage_Advanced" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Detail -->
            <ScrollViewer
                x:Name="DetailScroller"
                Grid.Column="1"
                Margin="0,40,0,0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled">
                <Grid x:Name="DetailHost" Padding="28,4,28,28">
                    <!-- One taskbar state -->
                    <StackPanel x:Name="StatePanel">
                        <TextBlock x:Name="StateTitle" FontSize="28" FontWeight="Bold" CharacterSpacing="-20" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="StateDescription" Style="{StaticResource SettingsRowDescriptionStyle}" FontSize="14" Margin="0,4,0,0" />

                        <Border x:Name="EnabledGroup" Style="{StaticResource SettingsGroupStyle}" Margin="0,20,0,0">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="SettingsPage_UseCustomAppearance" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock x:Uid="SettingsPage_UseCustomAppearance_Description" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton x:Name="EnabledSwitch" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" Click="AppearanceToggled" />
                            </Grid>
                        </Border>

                        <StackPanel x:Name="AppearanceOptions">
                            <StackPanel.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.22" />
                            </StackPanel.OpacityTransition>

                            <TextBlock x:Uid="SettingsPage_AppearanceHeader" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <StackPanel Padding="16,12,16,14" Spacing="10">
                                        <TextBlock x:Uid="SettingsPage_Effect" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <Border Background="{ThemeResource SettingsSegmentBackground}" CornerRadius="18" Padding="3">
                                            <Grid x:Name="SegmentGrid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition x:Name="BlurColumn" Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    x:Name="SegmentIndicator"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="15"
                                                    Background="{ThemeResource SettingsSegmentIndicator}"
                                                    BorderBrush="{ThemeResource SettingsSelectionStroke}"
                                                    BorderThickness="1" />
                                                <Button x:Name="SegNormal" Grid.Column="0" Style="{StaticResource SettingsSegmentButtonStyle}" Click="AccentClicked">
                                                    <TextBlock x:Uid="TrayFlyoutPage_Normal" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                                <Button x:Name="SegOpaque" Grid.Column="1" Style="{StaticResource SettingsSegmentButtonStyle}" Click="AccentClicked">
                                                    <TextBlock x:Uid="TrayFlyoutPage_Opaque" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                                <Button x:Name="SegClear" Grid.Column="2" Style="{StaticResource SettingsSegmentButtonStyle}" Click="AccentClicked">
                                                    <TextBlock x:Uid="TrayFlyoutPage_Clear" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                                <Button x:Name="SegBlur" Grid.Column="3" Style="{StaticResource SettingsSegmentButtonStyle}" Click="AccentClicked">
                                                    <TextBlock x:Uid="TrayFlyoutPage_Blur" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                                <Button x:Name="SegAcrylic" Grid.Column="4" Style="{StaticResource SettingsSegmentButtonStyle}" Click="AccentClicked">
                                                    <TextBlock x:Uid="TrayFlyoutPage_Acrylic" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                    <Grid x:Name="ColorRow" Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Uid="SettingsPage_Color" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock x:Name="ColorUnavailableText" x:Uid="SettingsPage_Color_Description" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <Border
                                            x:Name="ColorSwatch"
                                            Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="14"
                                            VerticalAlignment="Center"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Button x:Name="ChangeColorButton" x:Uid="SettingsPage_ChangeColor" Grid.Column="2" Style="{StaticResource SettingsPillButtonStyle}" VerticalAlignment="Center" Click="ChangeColorClicked" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Uid="SettingsPage_DetailsHeader" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Grid x:Name="PeekRow" Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Uid="SettingsPage_PeekButton" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock x:Uid="SettingsPage_PeekButton_Description" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="PeekSwitch" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" Click="AppearanceToggled" />
                                    </Grid>
                                    <Grid x:Name="LineRow" Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Uid="SettingsPage_LineButton" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock x:Uid="SettingsPage_LineButton_Description" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="LineSwitch" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" Click="AppearanceToggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- General -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">
                        <TextBlock x:Uid="SettingsPage_General" FontSize="28" FontWeight="Bold" CharacterSpacing="-20" />
                        <TextBlock x:Uid="SettingsPage_Description_General" Style="{StaticResource SettingsRowDescriptionStyle}" FontSize="14" Margin="0,4,0,0" />

                        <Border Style="{StaticResource SettingsGroupStyle}" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SettingsPage_OpenAtBoot" Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" Click="StartupToggled" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="SettingsPage_ExitRow" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock x:Uid="SettingsPage_ExitRow_Description" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <Button x:Uid="SettingsPage_Exit" Grid.Column="1" Style="{StaticResource SettingsPillButtonStyle}" VerticalAlignment="Center" Click="ExitClicked" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Advanced -->
                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                        <TextBlock x:Uid="SettingsPage_Advanced" FontSize="28" FontWeight="Bold" CharacterSpacing="-20" />
                        <TextBlock x:Uid="SettingsPage_Description_Advanced" Style="{StaticResource SettingsRowDescriptionStyle}" FontSize="14" Margin="0,4,0,0" />

                        <TextBlock x:Uid="SettingsPage_LogHeader" Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="TrayFlyoutPage_Advanced_OpenLogFile" Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" />
                                    <Button x:Name="OpenLogFileButton" x:Uid="SettingsPage_Open" Grid.Column="1" Style="{StaticResource SettingsPillButtonStyle}" VerticalAlignment="Center" Click="OpenLogFileClicked" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="TrayFlyoutPage_Advanced_LogVerbosity" Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" />
                                    <!-- same order as LogLevel -->
                                    <ComboBox x:Name="LogLevelBox" Grid.Column="1" MinWidth="160" CornerRadius="16" VerticalAlignment="Center" SelectionChanged="LogLevelSelectionChanged">
                                        <ComboBoxItem><TextBlock x:Uid="TrayFlyoutPage_Advanced_LogVerbosity_Trace" /></ComboBoxItem>
                                        <ComboBoxItem><TextBlock x:Uid="TrayFlyoutPage_Advanced_LogVerbosity_Debug" /></ComboBoxItem>
                                        <ComboBoxItem><TextBlock x:Uid="TrayFlyoutPage_Advanced_LogVerbosity_Information" /></ComboBoxItem>
                                        <ComboBoxItem><TextBlock x:Uid="TrayFlyoutPage_Advanced_LogVerbosity_Warning" /></ComboBoxItem>
                                        <ComboBoxItem><TextBlock x:Uid="TrayFlyoutPage_Advanced_LogVerbosity_Error" /></ComboBoxItem>
                                        <ComboBoxItem><TextBlock x:Uid="TrayFlyoutPage_Advanced_LogVerbosity_Critical" /></ComboBoxItem>
                                        <ComboBoxItem><TextBlock x:Uid="TrayFlyoutPage_Advanced_LogVerbosity_Off" /></ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="TrayFlyoutPage_Advanced_DumpDynamicState" Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" />
                                    <Button x:Name="DumpDynamicStateButton" x:Uid="SettingsPage_Dump" Grid.Column="1" Style="{StaticResource SettingsPillButtonStyle}" VerticalAlignment="Center" Click="DumpDynamicStateClicked" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Uid="SettingsPage_SettingsFileHeader" Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SettingsPage_SaveSettings" Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="SaveSettingsSwitch" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" Click="SaveSettingsToggled" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="TrayFlyoutPage_Advanced_EditSettings" Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" />
                                    <Button x:Uid="SettingsPage_Edit" Grid.Column="1" Style="{StaticResource SettingsPillButtonStyle}" VerticalAlignment="Center" Click="EditSettingsClicked" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="TrayFlyoutPage_Advanced_ResetSettings" Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" />
                                    <Button x:Uid="SettingsPage_Reset" Grid.Column="1" Style="{StaticResource SettingsPillButtonStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" Click="ResetSettingsClicked" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Uid="SettingsPage_MaintenanceHeader" Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="TrayFlyoutPage_Advanced_ResetDynamicState" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock x:Uid="SettingsPage_ResetDynamicState_Description" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <Button x:Uid="SettingsPage_Reset" Grid.Column="1" Style="{StaticResource SettingsPillButtonStyle}" VerticalAlignment="Center" Click="ResetDynamicStateClicked" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="TrayFlyoutPage_Advanced_CompactThunkHeap" Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" />
                                    <Button x:Uid="SettingsPage_Compact" Grid.Column="1" Style="{StaticResource SettingsPillButtonStyle}" VerticalAlignment="Center" Click="CompactThunkHeapClicked" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Window controls, top right in this order: minimize, maximize, close -->
            <StackPanel
                x:Name="TrafficLights"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="9"
                Padding="6"
                Margin="0,10,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                PointerEntered="TrafficLightsPointerEntered"
                PointerExited="TrafficLightsPointerExited">
                <Button x:Name="MinimizeLight" x:Uid="SettingsPage_Minimize" Style="{StaticResource TrafficLightStyle}" Background="#FEBC2E" Click="MinimizeClicked">
                    <Path x:Name="MinimizeGlyph" Style="{StaticResource TrafficLightGlyphStyle}" Data="M 3.3,6.5 L 9.7,6.5">
                        <Path.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Path.OpacityTransition>
                    </Path>
                </Button>
                <Button x:Name="MaximizeLight" x:Uid="SettingsPage_Maximize" Style="{StaticResource TrafficLightStyle}" Background="#28C840" Click="MaximizeClicked">
                    <!-- two corner arrowheads, pointing out to maximize and in to restore -->
                    <Path x:Name="MaximizeGlyph" Style="{StaticResource TrafficLightGlyphStyle}" StrokeThickness="0" Data="M 3.1,3.1 L 7.3,3.1 L 3.1,7.3 Z M 9.9,9.9 L 5.7,9.9 L 9.9,5.7 Z">
                        <Path.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Path.OpacityTransition>
                    </Path>
                </Button>
                <Button x:Name="CloseLight" x:Uid="SettingsPage_Close" Style="{StaticResource TrafficLightStyle}" Background="#FF5F57" Click="CloseLightClicked">
                    <Path x:Name="CloseGlyph" Style="{StaticResource TrafficLightGlyphStyle}" Data="M 3.94,3.94 L 9.06,9.06 M 9.06,3.94 L 3.94,9.06">
                        <Path.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Path.OpacityTransition>
                    </Path>
                </Button>
            </StackPanel>
            </Grid>
        </Grid>
    </UserControl>
</local:FramelessPage>
